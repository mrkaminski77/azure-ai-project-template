              "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', split(format('{0}/{1}', parameters('foundryResourceName'), parameters('projectName')), '/')[0], split(format('{0}/{1}', parameters('foundryResourceName'), parameters('projectName')), '/')[1]), parameters('orchestratorPrincipalId'), variables('foundryUserRoleId'))]",
              "properties": {
